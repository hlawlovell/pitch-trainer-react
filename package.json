{
  "name": "pitch-trainer",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:standalone": "node scripts/build-standalone.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config tests/e2e/vitest.config.ts",
    "test:all": "vitest run && vitest run --config tests/e2e/vitest.config.ts",
    "fixtures": "node tests/fixtures/sync/make-fixture.mjs"
  },
  "dependencies": {
    "pinyin-pro": "3.29.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "puppeteer-core": "^23.11.1",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
